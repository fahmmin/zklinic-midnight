pragma language_version 0.28;
import CompactStandardLibrary;

export enum IssuerStatus {
    None,
    Pending,
    Approved,
    Revoked,
}

export struct IssuerRecord {
    doctorKey: ZswapCoinPublicKey;
    licenseHash: Bytes<32>;
    attestationHash: Bytes<32>;
    issuerVerificationHash: Bytes<32>;
    status: IssuerStatus;
    submittedAt: Uint<64>;
    approvedAt: Uint<64>;
    revokedAt: Uint<64>;
}

constructor() {
    admin = ownPublicKey();
}

export ledger admin: ZswapCoinPublicKey;
export ledger pendingIssuers: Map<ZswapCoinPublicKey, Bytes<32>>;
export ledger issuers: Map<ZswapCoinPublicKey, IssuerRecord>;
// Milestone 2: Credential revocation - credentialId -> issuer, revoked set
export ledger issuedCredentials: Map<Bytes<32>, ZswapCoinPublicKey>;
export ledger revokedCredentials: Set<Bytes<32>>;
/** Next slot index per card for diagnosis commitments (flat map; slot key derived from credentialId + index). */
export ledger credentialDiagnosisNextIndex: Map<Bytes<32>, Uint<64>>;
export ledger diagnosisCommitmentBySlot: Map<Bytes<32>, Bytes<32>>;

// Milestone 3: Trial registry — manager posts trials; slots + criteria hash on-chain
export enum TrialStatus {
    Open,
    Closed,
    Full,
}

export struct TrialRecord {
    manager: ZswapCoinPublicKey;
    slotsTotal: Uint<64>;
    slotsFilled: Uint<64>;
    deadline: Uint<64>;
    status: TrialStatus;
    criteriaHash: Bytes<32>;
    /** Basis points: 10000 = 100%. Off-chain matching uses same threshold (default 7500 = 75%). */
    eligibilityThresholdBps: Uint<64>;
}

export ledger trials: Map<Bytes<32>, TrialRecord>;

export circuit submitIssuerRequest(licenseHash: Bytes<32>): [] {
    const caller = ownPublicKey();
    assert(!pendingIssuers.member(caller), "Issuer request already pending");

    if (issuers.member(caller)) {
        const record = issuers.lookup(caller);
        assert(record.status != IssuerStatus.Approved, "Issuer already approved");
    }

    pendingIssuers.insert(disclose(caller), disclose(licenseHash));
    return [];
}

export circuit approveIssuer(doctor: ZswapCoinPublicKey, attestationHash: Bytes<32>, issuerVerificationHash: Bytes<32>): [] {
    assert(ownPublicKey() == admin, "Only admin can approve issuer");
    assert(pendingIssuers.member(disclose(doctor)), "Issuer request not found");

    const hash = pendingIssuers.lookup(disclose(doctor));
    const record = IssuerRecord {
        doctorKey: doctor,
        licenseHash: hash,
        attestationHash: attestationHash,
        issuerVerificationHash: issuerVerificationHash,
        status: IssuerStatus.Approved,
        submittedAt: 0,
        approvedAt: 0,
        revokedAt: 0,
    };

    issuers.insert(disclose(doctor), disclose(record));
    pendingIssuers.remove(disclose(doctor));
    return [];
}

export circuit revokeIssuer(doctor: ZswapCoinPublicKey): [] {
    assert(ownPublicKey() == admin, "Only admin can revoke issuer");
    assert(issuers.member(disclose(doctor)), "Issuer not found");
    const current = issuers.lookup(disclose(doctor));

    const updated = IssuerRecord {
        doctorKey: current.doctorKey,
        licenseHash: current.licenseHash,
        attestationHash: current.attestationHash,
        issuerVerificationHash: current.issuerVerificationHash,
        status: IssuerStatus.Revoked,
        submittedAt: current.submittedAt,
        approvedAt: current.approvedAt,
        revokedAt: 0,
    };

    issuers.insert(disclose(doctor), disclose(updated));
    return [];
}

export circuit transferAdmin(newAdmin: ZswapCoinPublicKey): [] {
    assert(ownPublicKey() == admin, "Only admin can transfer admin role");
    admin = disclose(newAdmin);
    return [];
}

// Milestone 2: Credential Engine - doctor registers credential when issuing
export circuit registerCredential(credentialId: Bytes<32>): [] {
    const caller = ownPublicKey();
    assert(issuers.member(disclose(caller)), "Caller is not a registered issuer");
    const record = issuers.lookup(disclose(caller));
    assert(record.status == IssuerStatus.Approved, "Issuer must be approved to register credentials");
    assert(!issuedCredentials.member(disclose(credentialId)), "Credential already registered");
    issuedCredentials.insert(disclose(credentialId), disclose(caller));
    return [];
}

circuit diagnosisSlotKey(credentialId: Bytes<32>, slot: Uint<64>): Bytes<32> {
    const slotBytes = persistentHash<Uint<64>>(disclose(slot));
    return persistentHash<Vector<2, Bytes<32>>>([disclose(credentialId), slotBytes]);
}

circuit nextDiagnosisSlotForCard(credentialId: Bytes<32>): Uint<64> {
    if (credentialDiagnosisNextIndex.member(disclose(credentialId))) {
        return credentialDiagnosisNextIndex.lookup(disclose(credentialId));
    }
    return 0 as Uint<64>;
}

/** Append a doctor-signed diagnosis visit commitment to an existing card (same issuing doctor only). */
export circuit appendDiagnosisToCredential(credentialId: Bytes<32>, entryCommitment: Bytes<32>): [] {
    const caller = ownPublicKey();
    assert(issuers.member(disclose(caller)), "Caller is not a registered issuer");
    const record = issuers.lookup(disclose(caller));
    assert(record.status == IssuerStatus.Approved, "Issuer must be approved to append diagnoses");
    assert(issuedCredentials.member(disclose(credentialId)), "Credential not registered");
    assert(!revokedCredentials.member(disclose(credentialId)), "Credential revoked");
    const issuer = issuedCredentials.lookup(disclose(credentialId));
    assert(issuer == caller, "Only the issuing doctor can append to this card");
    const nextIdx = nextDiagnosisSlotForCard(disclose(credentialId));
    const slotKey = diagnosisSlotKey(disclose(credentialId), nextIdx);
    assert(!diagnosisCommitmentBySlot.member(disclose(slotKey)), "Diagnosis slot collision");
    diagnosisCommitmentBySlot.insert(disclose(slotKey), disclose(entryCommitment));
    credentialDiagnosisNextIndex.insert(disclose(credentialId), (nextIdx + (1 as Uint<64>)) as Uint<64>);
    return [];
}

// Milestone 2: Doctor revokes an incorrectly issued credential
export circuit revokeCredential(credentialId: Bytes<32>): [] {
    const caller = ownPublicKey();
    assert(issuers.member(disclose(caller)), "Caller is not a registered issuer");
    const record = issuers.lookup(disclose(caller));
    assert(record.status == IssuerStatus.Approved, "Issuer must be approved to revoke credentials");
    assert(issuedCredentials.member(disclose(credentialId)), "Credential not found");
    const issuer = issuedCredentials.lookup(disclose(credentialId));
    assert(issuer == caller, "Only the issuing doctor can revoke this credential");
    revokedCredentials.insert(disclose(credentialId));
    return [];
}

// Milestone 3: Trial manager creates a trial (caller becomes manager)
export circuit createTrial(
    trialId: Bytes<32>,
    slotsTotal: Uint<64>,
    deadline: Uint<64>,
    criteriaHash: Bytes<32>,
    eligibilityThresholdBps: Uint<64>
): [] {
    const caller = ownPublicKey();
    assert(!trials.member(disclose(trialId)), "Trial id already exists");
    assert(slotsTotal > 0, "Slots must be positive");
    assert(eligibilityThresholdBps > 0, "Threshold must be positive");
    assert(eligibilityThresholdBps <= 10000, "Threshold cannot exceed 100%");
    const record = TrialRecord {
        manager: caller,
        slotsTotal: slotsTotal,
        slotsFilled: 0,
        deadline: deadline,
        status: TrialStatus.Open,
        criteriaHash: criteriaHash,
        eligibilityThresholdBps: eligibilityThresholdBps,
    };
    trials.insert(disclose(trialId), disclose(record));
    return [];
}

export circuit closeTrial(trialId: Bytes<32>): [] {
    const caller = ownPublicKey();
    assert(trials.member(disclose(trialId)), "Trial not found");
    const t = trials.lookup(disclose(trialId));
    assert(t.manager == caller, "Only trial manager can close");
    assert(t.status == TrialStatus.Open, "Trial not open");
    const updated = TrialRecord {
        manager: t.manager,
        slotsTotal: t.slotsTotal,
        slotsFilled: t.slotsFilled,
        deadline: t.deadline,
        status: TrialStatus.Closed,
        criteriaHash: t.criteriaHash,
        eligibilityThresholdBps: t.eligibilityThresholdBps,
    };
    trials.insert(disclose(trialId), disclose(updated));
    return [];
}

// Internal: consume one slot, flipping the trial to Full on the last one.
circuit fillOneSlot(trialId: Bytes<32>): [] {
    const t = trials.lookup(trialId);
    assert(t.status == TrialStatus.Open, "Trial not open");
    assert(t.slotsFilled < t.slotsTotal, "No slots left");
    const newFilled = (t.slotsFilled + 1) as Uint<64>;
    trials.insert(trialId, TrialRecord {
        manager: t.manager,
        slotsTotal: t.slotsTotal,
        slotsFilled: newFilled,
        deadline: t.deadline,
        status: newFilled == t.slotsTotal ? TrialStatus.Full : TrialStatus.Open,
        criteriaHash: t.criteriaHash,
        eligibilityThresholdBps: t.eligibilityThresholdBps,
    });
    return [];
}

// ---------------------------------------------------------------------------
// Wave 3: private eligibility. The patient's clinical attributes live only in
// their private state. The public ledger learns one thing per application:
// "an unlinkable pseudonym holds a doctor-attested credential that satisfies
// this trial's criteria".
// ---------------------------------------------------------------------------

export struct LabResult {
    /** Normalized lab test name, UTF-8, zero padded. Zero bytes = empty slot. */
    code: Bytes<32>;
    /** Value x100 (two fixed decimals). */
    value: Uint<32>;
}

/** Doctor-attested attributes. Never written to the ledger; only a commitment is. */
export struct HealthAttributes {
    ageYears: Uint<8>;
    /** Normalized ICD codes, UTF-8, zero padded; unused slots are zero bytes. */
    diagnoses: Vector<4, Bytes<32>>;
    labs: Vector<4, LabResult>;
    /** Unix seconds. */
    expiresAt: Uint<64>;
    salt: Bytes<32>;
}

/** Machine-checkable trial criteria (public). Zero bytes = "no such rule". */
export struct EligibilityCriteria {
    minAge: Uint<8>;
    maxAge: Uint<8>;
    requiredDiagnosis: Bytes<32>;
    excludedDiagnosis: Bytes<32>;
    labCode: Bytes<32>;
    labMin: Uint<32>;
    labMax: Uint<32>;
}

/** Anonymity set: every attested credential commitment, from every doctor. */
export ledger credentialCommitments: HistoricMerkleTree<16, Bytes<32>>;
export ledger credentialCommitmentCount: Counter;
export ledger trialCriteria: Map<Bytes<32>, EligibilityCriteria>;
/** nullifier (per-trial pseudonym) -> trialId it was proven eligible for. */
export ledger eligibilityProofs: Map<Bytes<32>, Bytes<32>>;
export ledger trialEligibleCount: Map<Bytes<32>, Uint<64>>;
export ledger enrolledProofs: Set<Bytes<32>>;

witness patientSecretKey(): Bytes<32>;
witness healthAttributes(): HealthAttributes;
witness credentialPath(commitment: Bytes<32>): MerkleTreePath<16, Bytes<32>>;
/** Lets the patient's private state remember where it applied. */
witness recordApplication(trialId: Bytes<32>, nullifier: Bytes<32>): [];

/** Public half of the patient's secret; this is what the patient hands the doctor. */
export circuit patientPublicKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zkclinic:pk:v1"), sk]);
}

export circuit credentialCommitment(ownerPk: Bytes<32>, attrs: HealthAttributes): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>(
        [pad(32, "zkclinic:cred:v1"), ownerPk, persistentHash<HealthAttributes>(attrs)]);
}

/** Per-trial pseudonym: stable for (patient, trial), unlinkable across trials. */
export circuit trialNullifier(trialId: Bytes<32>, sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>([pad(32, "zkclinic:nul:v1"), trialId, sk]);
}

/** Approved doctor attests a credential by adding its commitment to the tree. */
export circuit issueCredentialCommitment(commitment: Bytes<32>): [] {
    const caller = ownPublicKey();
    assert(issuers.member(caller), "Caller is not a registered issuer");
    assert(issuers.lookup(caller).status == IssuerStatus.Approved, "Issuer must be approved to attest credentials");
    credentialCommitments.insert(disclose(commitment));
    credentialCommitmentCount.increment(1);
    return [];
}

/** Manager publishes machine-checkable criteria once; they cannot be changed afterwards. */
export circuit publishTrialCriteria(trialId: Bytes<32>, criteria: EligibilityCriteria): [] {
    const tid = disclose(trialId);
    const c = disclose(criteria);
    assert(trials.member(tid), "Trial not found");
    assert(trials.lookup(tid).manager == ownPublicKey(), "Only trial manager can publish criteria");
    assert(!trialCriteria.member(tid), "Criteria already published");
    assert(c.minAge <= c.maxAge, "minAge cannot exceed maxAge");
    assert(c.labMin <= c.labMax, "labMin cannot exceed labMax");
    assert(c.requiredDiagnosis != default<Bytes<32>>, "Required diagnosis missing");
    trialCriteria.insert(tid, c);
    return [];
}

/**
 * Patient proves eligibility in zero knowledge. Public output: a nullifier.
 * Private inputs (witnesses): secret key, attributes, Merkle path.
 * `asOf` is a public timestamp the prover picks (now + slack); the chain checks it is
 * not in the past and the circuit checks the credential outlives it.
 */
export circuit proveEligibility(trialId: Bytes<32>, asOf: Uint<64>): Bytes<32> {
    const tid = disclose(trialId);
    const now = disclose(asOf);
    assert(trials.member(tid), "Trial not found");
    assert(trials.lookup(tid).status == TrialStatus.Open, "Trial not open");
    assert(trialCriteria.member(tid), "Trial has no on-chain criteria");
    const c = trialCriteria.lookup(tid);

    const sk = patientSecretKey();
    const attrs = healthAttributes();
    const commitment = credentialCommitment(patientPublicKey(sk), attrs);
    const path = credentialPath(commitment);
    assert(path.leaf == commitment, "Merkle path is not for this credential");
    assert(credentialCommitments.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(path))),
        "Credential was not attested by an approved doctor");

    assert(blockTimeLte(now), "asOf is in the past");
    assert(attrs.expiresAt > now, "Credential expired");
    assert(attrs.ageYears >= c.minAge && attrs.ageYears <= c.maxAge, "Age outside trial range");
    assert(fold((hit, d) => hit || d == c.requiredDiagnosis, false, attrs.diagnoses),
        "Required diagnosis not present");
    if (c.excludedDiagnosis != default<Bytes<32>>) {
        assert(!fold((hit, d) => hit || d == c.excludedDiagnosis, false, attrs.diagnoses),
            "Excluded diagnosis present");
    }
    if (c.labCode != default<Bytes<32>>) {
        assert(fold((hit, l) => hit || (l.code == c.labCode && l.value >= c.labMin && l.value <= c.labMax),
            false, attrs.labs), "Lab requirement not met");
    }

    const nul = disclose(trialNullifier(tid, sk));
    assert(!eligibilityProofs.member(nul), "Already proven for this trial");
    eligibilityProofs.insert(nul, tid);
    const prior = trialEligibleCount.member(tid) ? trialEligibleCount.lookup(tid) : 0 as Uint<64>;
    trialEligibleCount.insert(tid, (prior + 1) as Uint<64>);
    recordApplication(tid, nul);
    return nul;
}

/** Manager enrolls a pseudonym. Only possible for a pseudonym that proved eligibility for this trial. */
export circuit recordEnrollment(trialId: Bytes<32>, nullifier: Bytes<32>): [] {
    const tid = disclose(trialId);
    const nul = disclose(nullifier);
    assert(trials.member(tid), "Trial not found");
    assert(trials.lookup(tid).manager == ownPublicKey(), "Only trial manager can record enrollment");
    assert(eligibilityProofs.member(nul), "No eligibility proof for this pseudonym");
    assert(eligibilityProofs.lookup(nul) == tid, "Proof is bound to a different trial");
    assert(!enrolledProofs.member(nul), "Pseudonym already enrolled");
    enrolledProofs.insert(nul);
    fillOneSlot(tid);
    return [];
}
