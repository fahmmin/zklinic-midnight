{
  "name": "zkclinic-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./managed/zkclinic/contract": {
      "types": "./dist/managed/zkclinic/contract/index.d.ts",
      "import": "./dist/managed/zkclinic/contract/index.js",
      "default": "./dist/managed/zkclinic/contract/index.js"
    }
  },
  "scripts": {
    "compact": "compact compile src/zkclinic.compact src/managed/zkclinic",
    "test": "vitest run",
    "test:compile": "npm run compact && vitest run",
    "strip-managed-sourcemaps": "find dist/managed -type f -name '*.map' -delete && find dist/managed -type f -name '*.js' -exec sed -i '/sourceMappingURL/d' {} +",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -Rf ./src/managed ./dist/managed && cp ./src/zkclinic.compact ./dist && npm run strip-managed-sourcemaps",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
