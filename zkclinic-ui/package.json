{
  "name": "zkclinic-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run copy-contract-assets && vite --mode preview",
    "dev:preview": "npm run copy-contract-assets && vite --mode preview",
    "dev:preprod": "npm run copy-contract-assets && vite --mode preprod",
    "dev:undeployed": "npm run copy-contract-assets && vite --mode undeployed",
    "build": "npm run copy-contract-assets && tsc && vite build --mode preview",
    "build:preview": "npm run copy-contract-assets && tsc && vite build --mode preview",
    "build:preprod": "npm run copy-contract-assets && tsc && vite build --mode preprod",
    "build:undeployed": "npm run copy-contract-assets && tsc && vite build --mode undeployed",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "copy-contract-assets": "mkdir -p ./public/zkclinic && cp -r ../contract/src/managed/zkclinic/* ./public/zkclinic"
  },
  "dependencies": {
    "@cred/neopop-web": "^1.0.0",
    "@midnight-ntwrk/compact-js": "2.4.0",
    "@midnight-ntwrk/compact-runtime": "0.14.0",
    "@midnight-ntwrk/dapp-connector-api": "4.0.0",
    "@midnight-ntwrk/ledger-v7": "7.0.0",
    "@midnight-ntwrk/midnight-js-contracts": "3.1.0",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "3.1.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "3.1.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "3.1.0",
    "@midnight-ntwrk/midnight-js-network-id": "3.1.0",
    "@midnight-ntwrk/midnight-js-types": "3.1.0",
    "@midnight-ntwrk/midnight-js-utils": "3.1.0",
    "@radix-ui/react-slot": "^1.2.4",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.14.0",
    "rxjs": "^7.8.1",
    "styled-components": "^6.3.12",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^5.1.1",
    "zkclinic-contract": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^4.0.15"
  }
}
